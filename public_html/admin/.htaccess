Options -Indexes
DirectoryIndex index.php index.html

<FilesMatch "^(index\.php|index\.html|login\.php|logout\.php|auth\.php)$">
    Require all granted
</FilesMatch>
<FilesMatch "^actions/.*\.php$">
    Require all granted
</FilesMatch>
<FilesMatch "^(?!index\.php$|index\.html$|login\.php$|logout\.php$|auth\.php$|actions/).*\.phtml?$">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^index\.html$ index.php [L]
