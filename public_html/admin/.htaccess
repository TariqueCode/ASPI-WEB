Options -Indexes
DirectoryIndex index.php index.html

# Never expose the raw dashboard template; /admin/ must go through index.php -> auth.php.
<Files "index.html">
    Require all denied
</Files>

<FilesMatch "^(index\.php|login\.php|logout\.php|auth\.php)$">
    Require all granted
</FilesMatch>

<FilesMatch "^actions/.*\.php$">
    Require all granted
</FilesMatch>

<FilesMatch "^(?!index\.php$|login\.php$|logout\.php$|auth\.php$|actions/).*\.phtml?$">
    Require all denied
</FilesMatch>
