Options -Indexes
DirectoryIndex index.php index.html
ErrorDocument 404 /404.php

<FilesMatch "\.(env|ini|log|sql|md|yml|yaml|backup)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(index\.php|index\.html|api\.php|config\.php|session\.php|committee\.php|founder\.php|404\.php)$">
    Require all granted
</FilesMatch>

<FilesMatch "^(?!index\.php$|index\.html$|api\.php$|config\.php$|session\.php$|committee\.php$|founder\.php$|404\.php$).*\.phtml?$">
    Require all denied
</FilesMatch>
